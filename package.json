{
  "name": "sentinel-atm-simulator",
  "productName": "SENTINEL Research Environment",
  "version": "0.3.0",
  "description": "Offline-first native security research environment for ATM emulation and controller-integrity experiments",
  "author": "SENTINEL Research Prototype",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:renderer": "tsc -b && vite build",
    "check:main": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/serial-manager.cjs && node --test electron/serial-manager.node-test.cjs",
    "test": "vitest run",
    "build": "npm run check:main && npm test && npm run build:renderer",
    "dist:mac": "npm run build:renderer && electron-builder --mac dmg zip --arm64",
    "dist:win": "npm run build:renderer && electron-builder --win nsis zip --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^13.0.0",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "org.sentinel.research-environment",
    "productName": "SENTINEL Research Environment",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
